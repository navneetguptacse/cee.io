# Site address: listens on port 80 for all hostnames (localhost, EC2 public IP, etc.)
:80 {
    # Token-protected Prometheus metrics
    @metrics {
        path /metrics /metrics/*
        header X-Metrics-Token {$METRICS_TOKEN:}
    }
    handle @metrics {
        uri strip_prefix /metrics
        reverse_proxy prometheus:9090
    }
    handle /metrics {
        respond "Unauthorized" 401
    }
    handle /metrics/* {
        respond "Unauthorized" 401
    }

    # Default fallback: Reverse proxy all other requests to CEE Go API
    handle {
        reverse_proxy cee:3000
    }

    # Compression
    encode gzip

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Structured JSON access logs
    log {
        output stdout
        format json
    }
}

